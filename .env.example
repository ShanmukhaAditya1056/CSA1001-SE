# DevTrack Environment Configuration Template
# Copy to .env for local development

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://devtrack:devtrack_local_password@localhost:5432/devtrack?schema=public

# Session Authentication & Cookie Secrets
JWT_SECRET=replace_with_a_long_random_secure_hex_secret_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=devtrack_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Password Hashing Parameters (Argon2id)
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# Rate Limiting & Security Headers
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Live Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
