rules_version = '2';

// DevTrack Firestore Security Rules
// Enforces user profile isolation, project permissions, and real-time invitations
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function directoryEntry(email) {
      return /databases/$(database)/documents/userDirectory/$(email);
    }

    // Users collection: Keyed by user.uid
    // Users can only write to their own users/{userId} document where request.auth.uid == userId
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // One record per registered account, keyed by lowercase email. Lookups are
    // by exact email only; listing the directory is not allowed.
    match /userDirectory/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && email == myEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail();
      allow delete: if false;
    }

    // Projects collection: Accessible to authenticated team members
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // Top-level Invitations Collection:
    // Authenticated users can create if request.resource.data.senderId == request.auth.uid
    // Both sender and recipient can read and update.
    match /invitations/{invitationId} {
      // Senders and recipients can read invitations (get and query list)
      allow get: if signedIn() && (resource == null
        || resource.data.senderId == request.auth.uid
        || resource.data.inviterId == request.auth.uid
        || resource.data.invitedEmail == myEmail()
        || resource.data.inviteeEmail == myEmail());

      allow list: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || resource.data.inviterId == request.auth.uid
        || resource.data.invitedEmail == myEmail()
        || resource.data.inviteeEmail == myEmail()
      );

      // Authenticated users can create if senderId matches their auth UID
      allow create: if signedIn()
        && (request.resource.data.senderId == request.auth.uid || request.resource.data.inviterId == request.auth.uid);

      // Both the sender and recipient can update
      allow update: if signedIn() && (
        resource.data.senderId == request.auth.uid
        || resource.data.inviterId == request.auth.uid
        || resource.data.invitedEmail == myEmail()
        || resource.data.inviteeEmail == myEmail()
      );

      allow delete: if false;
    }
  }
}

